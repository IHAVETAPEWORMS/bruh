        if (stp.op === 'b64') return { kind: 'a', code: `${rv}=${F.b64}(${i === 0 ? payloadRef : rv})` };
        if (stp.op === 'huff') return { kind: 'a', code: `${rv}=${F.huff}(${rv})` };
        if (stp.op === 'stream2') return { kind: 'a', code: `${rv}=${F.stream2}(${rv})` };
        if (stp.op === 'stream') return { kind: 'a', code: `${rv}=${F.stream}(${rv})` };
        if (stp.op === 'chk') return { kind: 's', code: `${chkRefs[chkI++]}(${rv})` };
