             + `local ${cl}=${lf}(${targetVar}) `
             + `${targetVar}=nil `
             + `pcall(collectgarbage,${luaStr("collect")}) `
             + `if not ${cl} then error(${hid('[nebfuscator] execution failed — payload damaged')},0) end `
             + `return ${cl}(...)`;
