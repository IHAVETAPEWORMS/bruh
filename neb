<script>
// ==================== PROTECTION SIGNATURE ====================
// Every output opens with:
//   local y={};y.n={e={b={["1.2"]="Protected with nebfuscator https://discord.gg/Jeecg933Ex"}}};
// The brand letters nest one table per letter (n -> e -> b), then the
// version key sits directly inside the last letter. Edit SIG to rebrand.
const SIG = {
    brand: 'neb',                       // nested table letters: n, e, b
    version: '1.2',                     // key inside the last table
    message: 'Protected with nebfuscator https://discord.gg/Jeecg933Ex'
};

function buildSignature() {
    const chain = SIG.brand.split('');
    let s = '{["' + SIG.version + '"]="' + SIG.message + '"}';
    for (let i = chain.length - 2; i >= 0; i--) s = '{' + chain[i + 1] + '=' + s + '}';
    return 'local y={};y.' + chain[0] + '=' + s + ';';
}

// ==================== ENGINE CONFIG ====================
const S = {
    strength: 2,
    antitamper: false,
    infiniteLoop: false,
    stringenc: true,
    doubleenc: false,
    checksum: true,
    numformat: true,
    payloadsplit: true,
    deadcode: true,
    controlflow: false,
    vmindirect: false,
    gccheck: false,
    antihook: false,
    junk: 2,
    chunkMin: 12,
    chunkMax: 24
};

const STRENGTH_INFO = {
    1: { name: 'Weak',   desc: 'lite b64 wrapper · fastest & smallest · cosmetic obfuscation only' },
    2: { name: 'Normal', desc: 'huffman + rc4 encryption + checksums · balanced' },
    3: { name: 'Strong', desc: 'rc4 ×2 + flow flattening + vm dispatch · heaviest' }
};

function applyStrength(level) {
    S.strength = parseInt(level, 10);
    if (S.strength === 1) {
        // WEAK — plain b64 wrapper, renamed vars, hex cosmetics.
        S.stringenc = false; S.doubleenc = false; S.checksum = false;
        S.numformat = true; S.payloadsplit = false; S.deadcode = false;
        S.controlflow = false; S.vmindirect = false; S.gccheck = false;
        S.antihook = false; S.junk = 0; S.chunkMin = 0; S.chunkMax = 0;
    } else if (S.strength === 2) {
        // NORMAL — huffman compression + single-layer rc4 + dual checksums + split payload.
        S.stringenc = true; S.doubleenc = false; S.checksum = true;
        S.numformat = true; S.payloadsplit = true; S.deadcode = true;
        S.controlflow = false; S.vmindirect = false; S.gccheck = false;
        S.antihook = false; S.junk = 2; S.chunkMin = 12; S.chunkMax = 24;
    } else if (S.strength === 3) {
        // STRONG — chained double rc4 (two independent keys) + everything structural.
        S.stringenc = true; S.doubleenc = true; S.checksum = true;
        S.numformat = true; S.payloadsplit = true; S.deadcode = true;
        S.controlflow = true; S.vmindirect = true; S.gccheck = true;
        S.antihook = true; S.junk = 5; S.chunkMin = 24; S.chunkMax = 48;
    }
}

// ==================== HELPERS ====================
const rnd = (a, b) => Math.floor(Math.random() * (b - a + 1)) + a;

function makeNamer() {
    const patterns = ['_l1I', '_I1l', '_llI', '_1Il', '_Il1', '_1lI', '_IIl', '_lII'];
    let counter = rnd(100, 999);
    const pool = [];
    for (const b of patterns) {
        for (let i = 0; i < 15; i++) {
            pool.push(`${b}${rnd(10, 99)}_${rnd(100, 999)}`);
        }
    }
    pool.sort(() => Math.random() - 0.5);
    let i = 0;
    return () => {
        if (i < pool.length) return pool[i++];
        return `_0x${(++counter).toString(16)}_${rnd(10, 99)}`;
    };
}

// Number formatting scales with strength:
//   1 = plain hex only, 2 = mixed, 3 = aggressive arithmetic mangling
function fmtNum(n, st) {
    if (!Number.isInteger(n) || n < 0 || !st.numformat) return String(n);
    const hex = '0x' + n.toString(16).toUpperCase();
    if (n >= 0x100000000) return hex; // keep huge values exact (no precision loss in arithmetic form)
    const r = Math.random();
    if (st.strength === 1) return hex;
    if (st.strength === 3) {
        if (r < 0.75 && n > 3) {
            const off = rnd(1, Math.min(n, 0xFFFF));
            return `(0x${(n + off).toString(16).toUpperCase()}-0x${off.toString(16).toUpperCase()})`;
        }
        return hex;
    }
    if (r < 0.5) return hex;
    if (r < 0.85 && n > 5) {
        const off = rnd(1, Math.min(n, 30));
        return `(0x${(n + off).toString(16).toUpperCase()}-0x${off.toString(16).toUpperCase()})`;
    }
    return String(n);
}

function luaStr(str) {
    let out = '"';
    for (let i = 0; i < str.length; i++) {
        const c = str.charCodeAt(i);
        if (str[i] === '"') out += '\\"';
        else if (str[i] === '\\') out += '\\\\';
        else if (c >= 32 && c < 127) out += str[i];
        else out += '\\' + String(c).padStart(3, '0'); // 3-digit escapes avoid "\9"+"5" => "\95" bugs
    }
    return out + '"';
}

function hiddenStr(s, num) {
    const codes = [];
    for (let i = 0; i < s.length; i++) {
        codes.push(num(s.charCodeAt(i)));
    }
    return 'string.char(' + codes.join(',') + ')';
}

function genRandomAlphabet() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'.split('');
    for (let i = chars.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [chars[i], chars[j]] = [chars[j], chars[i]];
    }
    return chars.join('');
}

function genKey() {
    const c = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    let k = '';
    const len = rnd(14, 22);
    for (let i = 0; i < len; i++) k += c[rnd(0, c.length - 1)];
    return k;
}

// ==================== STREAM CIPHER & ENGINES ====================
function rc4Process(bytes, keyStr) {
    const S = new Uint8Array(256);
    for (let i = 0; i < 256; i++) S[i] = i;
    let j = 0;
    for (let i = 0; i < 256; i++) {
        j = (j + S[i] + keyStr.charCodeAt(i % keyStr.length)) % 256;
        const tmp = S[i]; S[i] = S[j]; S[j] = tmp;
    }
    let i = 0, j2 = 0;
    const out = new Uint8Array(bytes.length);
    for (let k = 0; k < bytes.length; k++) {
        i = (i + 1) % 256;
        j2 = (j2 + S[i]) % 256;
        const tmp = S[i]; S[i] = S[j2]; S[j2] = tmp;
        const K = S[(S[i] + S[j2]) % 256];
        const salt = (k * 7 + 13) % 256;
        out[k] = bytes[k] ^ K ^ salt;
    }
    return out;
}

function bytesToB64Custom(bytes, alphabet) {
    let out = '';
    let buf = 0, bits = 0;
    for (let i = 0; i < bytes.length; i++) {
        buf = (buf << 8) | bytes[i];
        bits += 8;
        while (bits >= 6) {
            bits -= 6;
            out += alphabet[(buf >> bits) & 0x3F];
        }
    }
    if (bits > 0) out += alphabet[(buf << (6 - bits)) & 0x3F];
    return out;
}

function b64CustomToBytes(s, alphabet) {
    const map = {};
    for (let i = 0; i < alphabet.length; i++) map[alphabet[i]] = i;
    let buf = 0, bits = 0;
    const out = [];
    for (let i = 0; i < s.length; i++) {
        const v = map[s[i]];
        if (v !== undefined) {
            buf = (buf << 6) | v;
            bits += 6;
            if (bits >= 8) {
                bits -= 8;
                out.push((buf >> bits) & 0xFF);
            }
        }
    }
    return new Uint8Array(out);
}

function huffmanEncode(bytes) {
    const freq = new Array(256).fill(0);
    for (const b of bytes) freq[b]++;
    const syms = [];
    for (let i = 0; i < 256; i++) if (freq[i] > 0) syms.push(i);
    const lengths = {};
    if (syms.length === 1) {
        lengths[syms[0]] = 1;
    } else {
        let nodes = syms.map(s => ({ s, f: freq[s] }));
        while (nodes.length > 1) {
            nodes.sort((x, y) => x.f - y.f);
            const A = nodes.shift(), B = nodes.shift();
            nodes.push({ f: A.f + B.f, l: A, r: B });
        }
        (function walk(n, d) {
            if (n.s !== undefined) { lengths[n.s] = Math.max(d, 1); return; }
            walk(n.l, d + 1); walk(n.r, d + 1);
        })(nodes[0], 0);
    }
    const order = Object.keys(lengths).map(Number).sort((a, b) => lengths[a] - lengths[b] || a - b);
    let code = 0, prev = lengths[order[0]];
    const bitsOf = {};
    for (const s of order) {
        const len = lengths[s];
        code <<= (len - prev);
        bitsOf[s] = code.toString(2).padStart(len, '0');
        code += 1; prev = len;
    }
    let bp = 0, cur = 0, bitCount = 0;
    const out = [];
    for (const b of bytes) {
        const bits = bitsOf[b];
        for (let i = 0; i < bits.length; i++) {
            cur = (cur << 1) | (bits.charCodeAt(i) === 49 ? 1 : 0);
            bp++; bitCount++;
            if (bp === 8) { out.push(cur); cur = 0; bp = 0; }
        }
    }
    if (bp > 0) out.push(cur << (8 - bp));
    return { lengths, bitCount, bytes: out };
}

function checksumBytes(u8, salt) {
    let s = salt >>> 0;
    for (let i = 0; i < u8.length; i++) {
        s = (u8[i] * (i % 11 + 5) + (i * 3 + 7) + s) % 4294967296;
    }
    return s >>> 0;
}

function huffDecodeJS(bytes, lengths, bitCount) {
    const entries = Object.keys(lengths).map(Number).sort((a, b) => lengths[a] - lengths[b] || a - b);
    const maxLen = Math.max(...entries.map(s => lengths[s]));
    const Q = Math.pow(2, maxLen);
    const M = {};
    let code = 0, prev = lengths[entries[0]];
    for (const s of entries) {
        const l = lengths[s];
        code *= Math.pow(2, l - prev);
        M[l * Q + code] = s;
        code += 1; prev = l;
    }
    let acc = 0, cl = 0, pos = 0;
    const out = [];
    outer:
    for (let i = 0; i < bytes.length; i++) {
        const b = bytes[i];
        for (let j = 7; j >= 0; j--) {
            if (pos >= bitCount) break outer;
            acc = acc * 2 + Math.floor(b / Math.pow(2, j)) % 2;
            cl++; pos++;
            const s = M[cl * Q + acc];
            if (s !== undefined) { out.push(s); acc = 0; cl = 0; }
        }
    }
    return new Uint8Array(out);
}

// ==================== LUA BODIES ====================
// b64Body closes exactly THREE blocks (for / if v / if bits>=8).
// (A 4th `end` here was the cause of the ":11: Expected ')'" bug.)
function b64Body(ctx) {
    return ('local T={} for i=1,#' + ctx.AL + ' do T[' + ctx.AL + ':sub(i,i)]=i-1 end '
    + 'local buf,bits,out=0,0,{} for i=1,#s do local v=T[s:sub(i,i)] if v then '
    + 'buf=buf*64+v bits=bits+6 if bits>=8 then bits=bits-8 '
    + 'out[#out+1]=string.char(math.floor(buf/2^bits)%256) buf=buf%2^bits end end end '
    + 'return table.concat(out)');
}

function huffBody(ctx) {
    return ('local sy={} for k,v in pairs(' + ctx.LENS + ') do sy[#sy+1]={k,v} end '
    + 'table.sort(sy,function(x,y) if x[2]~=y[2] then return x[2]<y[2] end return x[1]<y[1] end) '
    + 'local M={} local c=0 local p=sy[1][2] '
    + 'for i=1,#sy do c=c*2^(sy[i][2]-p) M[sy[i][2]*' + ctx.Q + '+c]=sy[i][1] c=c+1 p=sy[i][2] end '
    + 'local acc,cl,pos,out=0,0,0,{} '
    + 'for i=1,#d do local b=d:byte(i) '
    + 'for j=7,0,-1 do if pos>=' + ctx.BITS + ' then break end '
    + 'acc=acc*2+math.floor(b/2^j)%2 cl=cl+1 pos=pos+1 '
    + 'local s2=M[cl*' + ctx.Q + '+acc] '
    + 'if s2 then out[#out+1]=string.char(s2) acc=0 cl=0 end end '
    + 'if pos>=' + ctx.BITS + ' then break end end '
    + 'return table.concat(out)');
}

function streamCipherBody(ctx) {
    return ('local function bx(a,b) if bit32 and bit32.bxor then return bit32.bxor(a,b) end '
    + 'if bit and bit.bxor then return bit.bxor(a,b) end '
    + 'local r,p=0,1 for i=1,8 do local x,y=a%2,b%2 if x~=y then r=r+p end '
    + 'a=math.floor((a-x)/2) b=math.floor((b-y)/2) p=p*2 end return r end '
    + 'local S={} for i=0,255 do S[i]=i end '
    + 'local j,klen=0,#' + ctx.KEY + ' '
    + 'for i=0,255 do local kc=' + ctx.KEY + ':byte((i%klen)+1) j=(j+S[i]+kc)%256 local tmp=S[i] S[i]=S[j] S[j]=tmp end '
    + 'local i,j2,out=0,0,{} '
    + 'for k=1,#s do i=(i+1)%256 j2=(j2+S[i])%256 local tmp=S[i] S[i]=S[j2] S[j2]=tmp '
    + 'local K=S[(S[i]+S[j2])%256] local salt=((k-1)*7+13)%256 '
    + 'out[#out+1]=string.char(bx(bx(s:byte(k),K),salt)) end '
    + 'return table.concat(out)');
}

function chkBody(salt, target, msgExpr) {
    return ('local c=' + salt + ' for i=0,#s-1 do local b=s:byte(i+1) '
    + 'c=(b*(i%11+5)+(i*3+7)+c)%4294967296 end '
    + 'if c~=' + target + ' then error(' + msgExpr + ',0) end');
}

// ==================== GUARDS ====================
function buildAntiHookGuard(N, num, st, hide) {
    const q = s => hide ? hide(s) : luaStr(s);
    const L = [];
    const fChk = N(), sHex = N(), tSub = N(), mFl = N(), pCall = N(), lStr = N();
    L.push(`local ${pCall}=pcall local ${sHex}=string.char local ${tSub}=table.concat local ${mFl}=math.floor local ${lStr}=(loadstring or load)`);
    L.push(`local function ${fChk}() `
        + `if ${sHex}(65,66,67)~=${q("ABC")} then return false end `
        + `if ${tSub}({${q("n")},${q("e")},${q("b")},${q("f")}})~=${q("nebf")} then return false end `
        + `if ${mFl}(4.9)~=4 then return false end `
        + `local ok,res=${pCall}(function() return 1337 end) `
        + `if not ok or res~=1337 then return false end `
        + `if not ${lStr} then return false end `
        + `local ok2,res2=${pCall}(${lStr},${q("return 90")}) `
        + `if not ok2 or type(res2)~=${q("function")} or res2()~=90 then return false end `
        + `return true end`);
    L.push(`if not ${fChk}() then while true do end return end`);
    return { lines: L };
}

