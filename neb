function junkLine(N, num) {
    const t = rnd(0, 3);
    const v = N(), a = N(), b = N();
    if (t === 0) return `do local ${v} = {} ${v}[${num(1)}] = ${num(rnd(10, 99))} ${v}[${num(2)}] = ${v} end`;
    if (t === 1) return `do local function ${v}(${a}) return (${a} * ${num(rnd(2, 7))}) % ${num(255)} end local ${b} = ${v}(${num(rnd(10, 50))}) end`;
    if (t === 2) return `do local ${v} = (${num(rnd(100, 999))} * ${num(rnd(2, 8))}) % ${num(500)} end`;
    return `do local ${v} = {${num(rnd(1, 9))}, ${num(rnd(10, 19))}} local ${a} = ${v}[${num(1)}] end`;
}

function gcLine(N, num) {
    const t = N(), i = N();
    return `pcall(function() local ${t}={} for ${i}=1,20000 do ${t}[${i}]={} end ${t}=nil collectgarbage(${luaStr("collect")}) end)`;
}

// ==================== STRUCTURAL CHECKER ====================
// Validates balanced blocks / parens / braces of generated Lua.
// Safety net that catches unbalanced `end` bugs before output ships.
function luaStructuralCheck(code) {
    let i = 0;
    const n = code.length;
    let blocks = 0, parens = 0, braces = 0, brackets = 0;
    const isNameChar = c => (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c === '_';
    while (i < n) {
        const c = code[i];
        if (c === '-' && code[i + 1] === '-') {
            const j = i + 2;
            if (code[j] === '[') {
                let eq = 0;
                while (code[j + 1 + eq] === '=') eq++;
                if (code[j + 1 + eq] === '[') {
                    const close = ']' + '='.repeat(eq) + ']';
                    const end = code.indexOf(close, j + 2 + eq);
                    if (end === -1) return { ok: false, err: 'unterminated long comment' };
                    i = end + close.length;
                    continue;
                }
            }
            while (i < n && code[i] !== '\n') i++;
            continue;
        }
        if (c === '[') {
            let eq = 0;
            while (code[i + 1 + eq] === '=') eq++;
            if (code[i + 1 + eq] === '[') {
                const close = ']' + '='.repeat(eq) + ']';
                const end = code.indexOf(close, i + 2 + eq);
                if (end === -1) return { ok: false, err: 'unterminated long string' };
                i = end + close.length;
                continue;
            }
            brackets++;
            i++;
            continue;
        }
        if (c === '"' || c === "'") {
            i++;
            while (i < n) {
                if (code[i] === '\\') { i += 2; continue; }
                if (code[i] === c) { i++; break; }
                if (code[i] === '\n') return { ok: false, err: 'unterminated quoted string' };
                i++;
            }
            continue;
        }
        if (c === '(') { parens++; i++; continue; }
        if (c === ')') { parens--; if (parens < 0) return { ok: false, err: 'unexpected )' }; i++; continue; }
        if (c === '{') { braces++; i++; continue; }
        if (c === '}') { braces--; if (braces < 0) return { ok: false, err: 'unexpected }' }; i++; continue; }
        if (c === ']') { brackets--; if (brackets < 0) return { ok: false, err: 'unexpected ]' }; i++; continue; }
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c === '_') {
            let j = i + 1;
            while (j < n && isNameChar(code[j])) j++;
            const w = code.slice(i, j);
            if (w === 'function' || w === 'if' || w === 'do' || w === 'repeat') blocks++;
            else if (w === 'end' || w === 'until') {
                blocks--;
                if (blocks < 0) return { ok: false, err: 'extra end/until' };
            }
            i = j;
            continue;
        }
        i++;
    }
    if (parens !== 0) return { ok: false, err: `paren balance off by ${parens}` };
    if (braces !== 0) return { ok: false, err: `brace balance off by ${braces}` };
    if (brackets !== 0) return { ok: false, err: `bracket balance off by ${brackets}` };
    if (blocks !== 0) return { ok: false, err: `block (end) balance off by ${blocks}` };
    return { ok: true };
}

// ==================== OBFUSCATOR BUILDER ====================
function preparePayload(input, st) {
    const srcU8 = new TextEncoder().encode(input);
    const alphabet = genRandomAlphabet();
    let key = null, key2 = null, wire = srcU8;

    if (st.stringenc) {
        key = genKey();
        wire = rc4Process(wire, key);
        if (st.doubleenc) {           // Strong only: second independent chained key
            key2 = genKey();
            wire = rc4Process(wire, key2);
        }
    }

    const b1Bytes = wire;
    const salt1 = rnd(1, 0xFFFFFF), salt2 = rnd(1, 0xFFFFFF);
    let h = null;
    if (st.stringenc) h = huffmanEncode(b1Bytes);

    const payload = st.stringenc ? bytesToB64Custom(new Uint8Array(h.bytes), alphabet) : bytesToB64Custom(srcU8, alphabet);
    const ck1 = st.checksum ? checksumBytes(b1Bytes, salt1) : 0;
    const ck2 = st.checksum ? checksumBytes(srcU8, salt2) : 0;

    return {
        srcU8, key, key2, alphabet, salt1, salt2, h, payload, ck1, ck2,
        Q: h ? Math.pow(2, Math.max(...Object.values(h.lengths))) : 1
    };
}

function verifyChain(o) {
    try {
        let src;
        if (o.stringenc) {
            const hb = b64CustomToBytes(o.payload, o.alphabet);
            let rawDecoded = huffDecodeJS(hb, o.lengths, o.bitCount);
            if (o.checksumOn && checksumBytes(rawDecoded, o.salt1) !== o.ck1) {
                return { ok: false, step: 'layer-1 checksum mismatch' };
            }
            if (o.key2) rawDecoded = rc4Process(rawDecoded, o.key2);
            src = o.key ? rc4Process(rawDecoded, o.key) : rawDecoded;
            if (o.checksumOn && checksumBytes(src, o.salt2) !== o.ck2) {
                return { ok: false, step: 'layer-2 checksum mismatch' };
            }
        } else {
            src = b64CustomToBytes(o.payload, o.alphabet);
            if (o.checksumOn && checksumBytes(src, o.salt1) !== o.ck1) {
                return { ok: false, step: 'checksum' };
            }
        }
        const text = new TextDecoder().decode(src);
        return { ok: text === o.original };
    } catch (e) {
        return { ok: false, step: e.message };
    }
}

function buildPacked(input, st) {
    const N = makeNamer();
    const num = n => fmtNum(n, st);
    const hid = s => hiddenStr(s, num);
    const P = preparePayload(input, st);

    // Decode chain. Strong adds an extra 'stream2' step (outer key unwrapped first).
    const steps = [];
    if (st.stringenc) {
        steps.push({ op: 'b64' }, { op: 'huff' });
        if (st.checksum) steps.push({ op: 'chk', salt: P.salt1, ck: P.ck1 });
        if (P.key2) steps.push({ op: 'stream2' });
        steps.push({ op: 'stream' });
        if (st.checksum) steps.push({ op: 'chk', salt: P.salt2, ck: P.ck2 });
    } else {
        steps.push({ op: 'b64' });
        if (st.checksum) steps.push({ op: 'chk', salt: P.salt1, ck: P.ck1 });
    }
    steps.push({ op: 'load' });

    const L = [];
    const push = s => L.push(s);
    push(buildSignature());              // <<< "Protected with nebfuscator" line
    push('return(function(...)');

    if (st.antihook) {
        buildAntiHookGuard(N, num, st, hid).lines.forEach(x => push(x));
    }
    if (st.antitamper) {
        buildGuardLua(N, num, st, hid).lines.forEach(x => push(x));
    } else if (st.infiniteLoop) {
        buildInfiniteLoopGuard(N, num, st, hid).lines.forEach(x => push(x));
    }
    if (st.gccheck) push(gcLine(N, num));

    // Junk volume scales with strength (0 / 2 / 5 per section)
    const deadCodeRuns = st.deadcode ? (st.junk || 0) : 0;
    for (let d = 0; d < deadCodeRuns; d++) push(junkLine(N, num));

    let AL, LENS, BITS, KEY, KEY2 = null, payloadRef, F = {}, chkRefs = [];
    if (st.vmindirect) {
        const R = N();
        push(`local ${R}={} ${R}[1]=${R} ${R}[2]=3 ${R}[3]={}`);

