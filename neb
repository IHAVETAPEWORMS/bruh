            const partCount = rnd(st.chunkMin || 12, st.chunkMax || 24);
            const cs = Math.max(20, Math.ceil(P.payload.length / partCount));
            const parts = [];
            for (let j = 0; j < P.payload.length; j += cs) parts.push(P.payload.slice(j, j + cs));
            const slotIds = [];
            while (slotIds.length < parts.length) {
                const s2 = rnd(10, 25 + parts.length * 4);
                if (!slotIds.includes(s2)) slotIds.push(s2);
            }
            parts.forEach((c, i) => push(`${R}[${num(slotIds[i])}]=[[${c}]]`));
            push(`${R}[4]=${slotIds.map(s2 => `${R}[${num(s2)}]`).join('..')}`);
        } else {
            push(`${R}[4]=[[${P.payload}]]`);
        }

        if (st.stringenc) {
            push(`${R}[5]={${Object.entries(P.h.lengths).map(([s, l]) => `[${num(+s)}]=${num(l)}`).join(',')}}`);
            push(`${R}[6]=${num(P.h.bitCount)}`);
            push(`${R}[7]=${luaStr(P.key)}`);
            if (P.key2) push(`${R}[9]=${luaStr(P.key2)}`);
        }
        push(`${R}[8]=${luaStr(P.alphabet)}`);

        AL = `${R}[8]`;
        LENS = `${R}[5]`;
        BITS = `${R}[6]`;
        KEY = `${R}[7]`;
        KEY2 = P.key2 ? `${R}[9]` : null;
        payloadRef = `${R}[4]`;

