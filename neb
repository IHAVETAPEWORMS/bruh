        push(`local ${AL}=${luaStr(P.alphabet)}`);
        payloadRef = N();
        if (st.payloadsplit && P.payload.length > 60) {
            const partCount = rnd(st.chunkMin || 12, st.chunkMax || 24);
            const cs = Math.max(20, Math.ceil(P.payload.length / partCount));
            const parts = [];
            for (let j = 0; j < P.payload.length; j += cs) parts.push(P.payload.slice(j, j + cs));
            const names = parts.map(() => N());
            names.forEach((nm, i) => push(`local ${nm}=[[${parts[i]}]]`));
            push(`local ${payloadRef}=${names.join('..')}`);
        } else {
            push(`local ${payloadRef}=[[${P.payload}]]`);
        }
        if (st.stringenc) {
            LENS = N(); BITS = N(); KEY = N();
            push(`local ${LENS}={${Object.entries(P.h.lengths).map(([s, l]) => `[${num(+s)}]=${num(l)}`).join(',')}}`);
            push(`local ${BITS}=${num(P.h.bitCount)}`);
            push(`local ${KEY}=${luaStr(P.key)}`);
            if (P.key2) { KEY2 = N(); push(`local ${KEY2}=${luaStr(P.key2)}`); }
        }
        const fn = (args, body) => { const f = N(); push(`local function ${f}(${args}) ${body} end`); return f; };
        F.b64 = fn('s', b64Body({ AL }));
        if (st.stringenc) {
            if (KEY2) F.stream2 = fn('s', streamCipherBody({ KEY: KEY2 }));
            F.huff = fn('d', huffBody({ LENS, BITS, Q: num(P.Q) }));
            F.stream = fn('s', streamCipherBody({ KEY }));
        }
