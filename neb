    if (st.controlflow) {
        const Kc = N(), KP = N();
        push(`local ${Kc}={} local function ${KP}(x,y,id) local r if bit32 and bit32.bxor then r=bit32.bxor(x,y) elseif bit and bit.bxor then r=bit.bxor(x,y) else r=0 local p=1 for i=1,16 do local a2,b2=x%2,y%2 if a2~=b2 then r=r+p end x=math.floor((x-a2)/2) y=math.floor((y-b2)/2) p=p*2 end end ${Kc}[id]=r return r end`);
        const stateRefs = [];
        const used = new Set();
        while (used.size < steps.length) used.add(rnd(0x10, 0x7FFF));
        const sArr = [...used];
        sArr.forEach((s, idx) => {
            const id = rnd(0x10, 0xFFFFF) + idx * 1000;
            const x = rnd(1, 0x7FFF);
            const y = x ^ s;
            stateRefs.push(`(${Kc}[${num(id)}] or ${KP}(${num(x)},${num(y)},${num(id)}))`);
        });
        const sv = N();
        push(`local ${sv}=${stateRefs[0]} local ${rv}`);
        push('while true do');
        steps.forEach((stp, i) => {
            const kw = i === 0 ? 'if' : 'elseif';
            if (stp.op === 'load') {
                push(`${kw} ${sv}==${stateRefs[i]} then ${emitSafeLoader(rv)}`);
            } else {
                const b = stepBody(stp, i);
                push(`${kw} ${sv}==${stateRefs[i]} then ${b.code} ${sv}=${stateRefs[i + 1]}`);
            }
        });
        push('else break end');
        push('end');
    } else {
        push(`local ${rv}=${payloadRef}`);
        for (let i = 0; i < steps.length; i++) {
            const stp = steps[i];
            if (stp.op === 'load') push(emitSafeLoader(rv));
            else push(stepBody(stp, i).code);
        }
    }

    push('end)(...)');

    const lua = L.join(' ');

    // 1) verify the payload decode chain in JS
    const ver = verifyChain({
        payload: P.payload,
        alphabet: P.alphabet,
        lengths: P.h ? P.h.lengths : null,
        bitCount: P.h ? P.h.bitCount : 0,
        key: P.key,
        key2: P.key2,
        salt1: P.salt1,
        ck1: P.ck1,
        salt2: P.salt2,
        ck2: P.ck2,
        checksumOn: st.checksum,
        stringenc: st.stringenc,
        original: input
    });
    if (!ver.ok) return { lua: null, verified: false, err: ver.step };

    // 2) verify the generated Lua is structurally valid (blocks/parens balanced)
    const sanity = luaStructuralCheck(lua);
    if (!sanity.ok) return { lua: null, verified: false, err: 'lua structure: ' + sanity.err };

    return { lua, verified: true, layers: steps.length };
}

// ==================== MONACO & UI ====================
let editor = null;
let currentMode = 'input';
let inputContent = '-- paste your lua script here\nlocal Players = game:GetService("Players")\nlocal LocalPlayer = Players.LocalPlayer\n\nprint("Hello from nebfuscator! User: " .. LocalPlayer.Name)';
let outputContent = '';

require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.52.0/min/vs' } });
require(['vs/editor/editor.main'], function () {
    editor = monaco.editor.create(document.getElementById('editor-container'), {
        value: inputContent,
        language: 'lua',
        theme: 'vs-dark',
        fontSize: 13,
        fontFamily: 'Geist Mono, monospace',
        automaticLayout: true,
        minimap: { enabled: false },
        scrollBeyondLastLine: false,
        renderLineHighlight: 'none',
        lineNumbersMinChars: 3,
        padding: { top: 12, bottom: 12 }
    });
});

function updateEditorView() {
    if (!editor) return;
    if (currentMode === 'input') {
        editor.setValue(inputContent);
        editor.updateOptions({ readOnly: false });
    } else if (currentMode === 'output') {
        editor.setValue(outputContent || '-- obfuscated code will appear here');
        editor.updateOptions({ readOnly: true });
    }
}

// Tabs — save the input before leaving it
document.querySelectorAll('.tab').forEach(btn => {
    btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-tab');
        if (currentMode === 'input' && editor) {
            inputContent = editor.getValue();
        }
        currentMode = tabId;
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        btn.classList.add('active');
        updateEditorView();
    });
});

// Strength Slider Logic
const strengthSlider = document.getElementById('strengthSlider');
const strengthValue = document.getElementById('strengthValue');
const strengthDesc = document.getElementById('strengthDesc');

function renderFeatureTags() {
    const el = document.getElementById('featureTags');
    if (!el) return;
    el.innerHTML = '';
    const active = [];
    if (!S.stringenc) active.push('b64 wrapper');
    if (S.doubleenc) active.push('rc4 ×2');
    else if (S.stringenc) active.push('rc4');
    if (S.stringenc) active.push('huffman');
    if (S.checksum) active.push('checksum');
    if (S.numformat) active.push('num fmt');
    if (S.payloadsplit) active.push('split');
    if (S.deadcode) active.push('junk');
    if (S.controlflow) active.push('flow flat');
    if (S.vmindirect) active.push('vm table');
    if (S.gccheck) active.push('gc');
    if (S.antihook) active.push('anti-hook');
    if (S.antitamper) active.push('anti-tamper');
    if (S.infiniteLoop) active.push('loop guard');
    active.forEach(t => {
        const s = document.createElement('span');
        s.className = 'feature-tag';
        s.textContent = t;
        el.appendChild(s);
    });
}

function renderStrengthInfo() {
    const info = STRENGTH_INFO[S.strength] || STRENGTH_INFO[2];
    strengthValue.innerText = info.name;
    strengthDesc.innerText = info.desc;
    renderFeatureTags();
}

strengthSlider.addEventListener('input', (e) => {
    applyStrength(e.target.value);
    renderStrengthInfo();
});

// Guard Toggles (mutually exclusive)
const btnAntiTamper = document.getElementById('toggleAntiTamper');
const btnInfiniteLoop = document.getElementById('toggleInfiniteLoop');

btnAntiTamper.addEventListener('click', () => {
    S.antitamper = !S.antitamper;
    if (S.antitamper) {
        S.infiniteLoop = false;
        btnInfiniteLoop.classList.remove('active');
    }
    btnAntiTamper.classList.toggle('active', S.antitamper);
    renderFeatureTags();
});

btnInfiniteLoop.addEventListener('click', () => {
    S.infiniteLoop = !S.infiniteLoop;
    if (S.infiniteLoop) {
        S.antitamper = false;
        btnAntiTamper.classList.remove('active');
    }
    btnInfiniteLoop.classList.toggle('active', S.infiniteLoop);
    renderFeatureTags();
});

// Copy & Obfuscate Actions
const obfuscateBtn = document.getElementById('obfuscateBtn');
const copyBtn = document.getElementById('copyBtn');
const statusBar = document.getElementById('statusBar');
const statusText = document.getElementById('statusText');

function setStatus(type, msg) {
    statusBar.className = 'status-bar ' + (type || '');
    statusText.innerText = msg;
}

function copyToClipboard(text) {
    if (navigator.clipboard && window.isSecureContext) {
        return navigator.clipboard.writeText(text).catch(() => fallbackCopy(text));
    }
    return fallbackCopy(text);
}

function fallbackCopy(text) {
    return new Promise((resolve, reject) => {
        try {
            const textArea = document.createElement("textarea");
            textArea.value = text;
            textArea.style.position = "fixed";
            textArea.style.left = "-999999px";
            textArea.style.top = "-999999px";
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            const success = document.execCommand('copy');
            document.body.removeChild(textArea);
            if (success) resolve();
            else reject(new Error("execCommand failed"));
        } catch (err) {
            reject(err);
        }
    });
}

obfuscateBtn.addEventListener('click', () => {
    if (!editor) return;

    if (currentMode === 'input') {
        inputContent = editor.getValue();
    }

    if (!inputContent.trim()) {
        setStatus('error', 'error: input cannot be empty');
        return;
    }

    const label = (STRENGTH_INFO[S.strength] || {}).name || '';
    setStatus('', `obfuscating (${label.toLowerCase()})...`);
    obfuscateBtn.disabled = true;

    setTimeout(() => {
        const t0 = performance.now();
        try {
            const res = buildPacked(inputContent, S);
            const ms = Math.max(1, Math.round(performance.now() - t0));
            if (res.verified && res.lua) {
                outputContent = res.lua + '\n';
                const inK = (inputContent.length / 1024).toFixed(1);
                const outK = (outputContent.length / 1024).toFixed(1);
                setStatus('success', `obfuscated · protected with nebfuscator · ${inK}kb → ${outK}kb · ${res.layers} layers · ${label.toLowerCase()} · ${ms}ms`);

                currentMode = 'output';
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                document.querySelector('.tab[data-tab="output"]').classList.add('active');
                updateEditorView();
            } else {
                setStatus('error', `verification failed: ${res.err || 'error'}`);
            }
        } catch (err) {
            setStatus('error', `error: ${err.message}`);
        } finally {
            obfuscateBtn.disabled = false;
        }
    }, 50);
});

copyBtn.addEventListener('click', () => {
    let toCopy = '';
    if (currentMode === 'output') toCopy = outputContent;
    else if (currentMode === 'input' && editor) toCopy = editor.getValue();

    if (!toCopy) {
        setStatus('error', 'nothing to copy');
        return;
    }
    copyToClipboard(toCopy).then(() => {
        setStatus('success', 'copied to clipboard');
        setTimeout(() => setStatus('', 'ready'), 2000);
    }).catch(() => {
        setStatus('error', 'failed to copy');
    });
});

// Init: sync engine state with default slider position
applyStrength(2);
renderStrengthInfo();
</script>
